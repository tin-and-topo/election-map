# Copy this file to .env and provide only the values your project needs.
# Do not commit .env or place real secrets in this file.

# ArcGIS portal endpoint (use HTTPS and your organization's approved portal).
ARCGIS_PORTAL_URL=https://www.arcgis.com

# Prefer OAuth, a key vault, or interactive named-user authentication.
# ARCGIS_USERNAME=
# ARCGIS_PASSWORD=
# ARCGIS_API_KEY=
